{
  "name": "streamdeck-mcp-catalog-api",
  "version": "1.0.0",
  "description": "Serves this repo's catalog through the MCP Generic Registry API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "CATALOG_URL=../catalog.json tsx watch src/index.ts",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.7.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
